container_commands:
  01_install_certbot:
    command: |
      chmod +x /var/app/staging/bin/01-install-certbot.sh
      /var/app/staging/bin/01-install-certbot.sh
    
  02_setup_certificate:
    command: |
      chmod +x /var/app/staging/bin/02-setup-certificate.sh
      /var/app/staging/bin/02-setup-certificate.sh
  
  03_configure_nginx:
    command: |
      chmod +x /var/app/staging/bin/03-configure-nginx.sh
      /var/app/staging/bin/03-configure-nginx.sh
  
  04_verify_https:
    command: |
      chmod +x /var/app/staging/bin/04-verify-https.sh
      /var/app/staging/bin/04-verify-https.sh
  
  05_setup_renewal:
    command: |
      chmod +x /var/app/staging/bin/05-setup-renewal.sh
      /var/app/staging/bin/05-setup-renewal.sh